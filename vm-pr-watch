#!/usr/bin/env python3
"""pr-watch: wait, without spending model tokens, until there's GitHub news Dan could act on.

It polls `gh` every few minutes and exits as soon as something new and actionable shows up,
printing one line per item. A dispatcher runs it as a background command, so the session
sleeps for free and wakes only when the command exits. Run it again after handling the news.

    pr-watch [--interval 600] [--terms FILE] [--paths FILE] [--quiet-hours 22-7] [--weekends] [--now]

What counts as news (compared with the state file, so nothing is reported twice):
  - a review requested from Dan (new, or new commits since he was asked)
  - Dan's open PR: approved, changes requested, CI newly failing or newly green, new commits
    or new comments or reviews from someone else
  - an open PR or issue that involves Dan (mention, comment, assignment) with new activity
    from someone else
  - an open PR in the watched repos that has a line of the terms file in its title
    (topics from ~/threads.md), when it's new or has new commits
  - a teammate's PR opened in the last few days that changes files under Dan's areas (the paths
    file: `repo:prefix` lines, grouped under `# Area` comments), reported once
  - a Gerrit change of Dan's (gerrit.buildbuddy.io) with a patch set, vote or comment from someone
    else, and a change where Dan is a reviewer that's new or has a new patch set
  - an open PR in the watched repos, not Dan's, that you could help with: no review yet a day after
    it was opened ("unreviewed"), or no activity for a week ("languishing"); each is reported once
    when it gets there, and again only if it changes

Whatever Dan does himself (or an agent does as Dan: pushes, approvals, votes, comments) isn't news.
The first run records what's there and reports nothing (pass --now to report it); so does the first
poll that sees a kind of news this version added, so an upgrade doesn't report the backlog.
During quiet hours (Dan's time, --tz, default 22-7 America/Chicago) and on weekends it keeps polling and
remembering, but holds the news until quiet hours end; --weekends lets weekends through.
Exit status: 0 with news on stdout (or after --once); 1 when --once can't reach GitHub.
"""
import argparse, concurrent.futures, datetime, json, os, subprocess, sys, time
from zoneinfo import ZoneInfo

OWNER = "buildbuddy-io"
REPOS = [f"{OWNER}/buildbuddy", f"{OWNER}/buildbuddy-internal"]
FIELDS = "number,title,url,repository,author,updatedAt"
STATE = os.path.expanduser("~/.cache/pr-watch.json")
GERRIT = "gerrit-ssh.buildbuddy.io"
UNREVIEWED_AFTER = datetime.timedelta(days=1)
LANGUISHING_AFTER = datetime.timedelta(days=7)
AREA_WINDOW = datetime.timedelta(days=3)  # how far back to look for new PRs in Dan's areas


def gh(args, host=None):
    env = dict(os.environ)
    if host:
        env["GH_HOST"] = host
    r = subprocess.run(["gh"] + args, capture_output=True, text=True, env=env, timeout=120)
    if r.returncode != 0:
        raise RuntimeError(f"gh {' '.join(args[:3])}: {r.stderr.strip()[:200]}")
    return json.loads(r.stdout or "null")


def me():
    return gh(["api", "user"])["login"]


def checks(rollup):
    states = [(c.get("conclusion") or c.get("state") or c.get("status") or "").upper() for c in rollup or []]
    if any(s in ("FAILURE", "ERROR", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE") for s in states):
        return "failing"
    if any(s in ("", "PENDING", "QUEUED", "IN_PROGRESS", "EXPECTED", "WAITING") for s in states):
        return "pending"
    return "green" if states else "none"


def pr_detail(repo, number, host=None):
    """A PR's head, review decision, checks and conversation. A token that can't read checks
    in some repo still gets the rest; a PR it can't read at all gives {} (and is still watched
    by its search result)."""
    fields = "headRefOid,reviewDecision,comments,reviews,isDraft,commits"
    try:
        return gh(["pr", "view", str(number), "-R", repo, "--json", fields + ",statusCheckRollup"], host)
    except RuntimeError:
        pass
    try:
        return gh(["pr", "view", str(number), "-R", repo, "--json", fields], host)
    except RuntimeError as e:
        print(f"pr-watch: {repo}#{number}: {e}", file=sys.stderr)
        return {}


def others(items, login):
    """Comments or reviews by people other than Dan (and not bots)."""
    return sum(1 for x in items or [] if (x.get("author") or {}).get("login") not in (login, None)
               and not (x.get("author") or {}).get("login", "").endswith("[bot]"))


def pushed_by_others(d, login):
    """Commits on a PR whose authors don't include Dan. Agents commit as Dan, so their pushes don't count."""
    return sum(1 for c in d.get("commits") or []
               if login not in [a.get("login") for a in c.get("authors") or []])


def issue_talk(repo, number, login):
    try:
        d = gh(["issue", "view", str(number), "-R", repo, "--json", "comments"])
    except RuntimeError:
        return None
    return others(d.get("comments"), login)


def gerrit(query):
    """Changes matching a Gerrit query, over ssh with the agents' key (~/.ssh/config). [] when Gerrit
    isn't set up on this VM or can't be reached: None."""
    try:
        r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", GERRIT, "gerrit", "query",
                            "--format=JSON", "--current-patch-set", "--all-approvals", "--comments", query],
                           capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    out = []
    for line in r.stdout.splitlines():
        try:
            c = json.loads(line)
        except ValueError:
            continue
        if "number" in c:
            out.append(c)
    return out


def who(account):
    account = account or {}
    return account.get("username") or account.get("email") or account.get("name")


def votes(change, skip=None):
    ps = change.get("currentPatchSet") or {}
    return sorted(f"{a.get('type')}{'+' if int(a.get('value', 0)) > 0 else ''}{a.get('value')} by {who(a.get('by'))}"
                  for a in ps.get("approvals") or [] if skip is None or who(a.get("by")) != skip)


def gerrit_others(change):
    """For Dan's own change: (patch sets uploaded by someone else, comments by someone else)."""
    owner = who(change.get("owner"))
    ps = change.get("currentPatchSet") or {}
    theirs_ps = ps.get("revision") if who(ps.get("uploader")) not in (owner, None) else ""
    return theirs_ps, sum(1 for m in change.get("comments") or [] if who(m.get("reviewer")) != owner)


def ago(ts):
    t = datetime.datetime.fromisoformat(ts.replace("Z", "+00:00"))
    return datetime.datetime.now(datetime.timezone.utc) - t


def load_paths(path):
    """[(repo, prefix, area)] from a paths file; the area is the latest '# Area' comment."""
    out, area = [], ""
    try:
        lines = open(path).read().splitlines()
    except OSError:
        return out
    for line in lines:
        line = line.strip()
        if line.startswith("#"):
            area = line.lstrip("# ").strip()
        elif ":" in line:
            repo, prefix = line.split(":", 1)
            out.append((f"{OWNER}/{repo.strip()}", prefix.strip(), area or prefix.strip()))
    return out


def pr_files(repo, number):
    try:
        return [f["path"] for f in gh(["pr", "view", str(number), "-R", repo, "--json", "files"])["files"]]
    except (RuntimeError, KeyError, TypeError):
        return None


def snapshot(login, terms, prev=None, paths=()):
    """Everything worth watching right now: {key: {line fields, sig fields}}. prev, the last
    snapshot, saves re-reading conversations that haven't changed."""
    prev = prev or {}
    snap = {}
    pool = concurrent.futures.ThreadPoolExecutor(8)
    details = {}

    def prefetch(prs):
        for pr in prs:
            k = (pr["repository"]["nameWithOwner"], pr["number"])
            if k not in details:
                details[k] = pool.submit(pr_detail, *k)
        return prs

    def detail(repo, number):
        return details[(repo, number)].result()

    review = prefetch(gh(["search", "prs", "--review-requested=@me", "--state=open", "--json", FIELDS, "--limit", "50"]))
    mine = prefetch(gh(["search", "prs", "--author=@me", "--state=open", "--json", FIELDS, "--limit", "50"]))
    # Topics go in a few OR queries (GitHub allows five operators in one), since search is
    # rate-limited to 30 requests a minute.
    topical = []
    for i in range(0, len(terms), 6):
        group = terms[i:i + 6]
        query = [x for t in group for x in ("OR", t)][1:]  # gh quotes a term with spaces as a phrase
        for pr in gh(["search", "prs", *query, "--owner", OWNER, "--state=open", "--json", FIELDS, "--limit", "40"]):
            if (pr.get("author") or {}).get("login") != login and pr["repository"]["nameWithOwner"] in REPOS:
                # Search matches bodies too, which is mostly noise; keep title matches.
                term = next((t for t in group if t.lower() in pr["title"].lower()), None)
                if term:
                    topical.append((term, pr))
    prefetch([pr for _, pr in topical])
    today = datetime.datetime.now(datetime.timezone.utc).date()
    recent = gh(["search", "prs", "--owner", OWNER, "--state=open", "--draft=false",
                 "--created", f">={today - AREA_WINDOW}", "--json", FIELDS, "--limit", "100"]) if paths else []
    unreviewed = gh(["search", "prs", "--owner", OWNER, "--state=open", "--draft=false", "--review=none",
                     "--created", f"<{today - UNREVIEWED_AFTER}", "--sort", "created", "--json", FIELDS + ",createdAt",
                     "--limit", "40"])
    languishing = gh(["search", "prs", "--owner", OWNER, "--state=open", "--draft=false",
                      "--updated", f"<{today - LANGUISHING_AFTER}", "--sort", "updated", "--json", FIELDS,
                      "--limit", "40"])

    def add(key, kind, repo, number, title, url, sig):
        snap[key] = {"kind": kind, "repo": repo, "number": number, "title": title, "url": url, "sig": sig}

    for pr in review:
        repo = pr["repository"]["nameWithOwner"]
        d = detail(repo, pr["number"])
        add(f"rr {pr['url']}", "review requested", repo, pr["number"], pr["title"], pr["url"],
            {"head": d.get("headRefOid") or pr["updatedAt"]})

    for pr in mine:
        repo = pr["repository"]["nameWithOwner"]
        d = detail(repo, pr["number"])
        add(f"mine {pr['url']}", "your PR", repo, pr["number"], pr["title"], pr["url"],
            {"pushed": pushed_by_others(d, login), "decision": d.get("reviewDecision") or "",
             "ci": checks(d["statusCheckRollup"]) if "statusCheckRollup" in d else "unknown",
             "talk": others(d.get("comments"), login) + others(d.get("reviews"), login), "draft": d.get("isDraft")})

    for kind in ("prs", "issues"):
        for it in gh(["search", kind, "--involves=@me", "--owner", OWNER, "--state=open", "--json", FIELDS, "--limit", "50"]):
            repo = it["repository"]["nameWithOwner"]
            if (it.get("author") or {}).get("login") == login:
                continue  # Dan's own: covered above (PRs) or he knows (issues)
            key = f"inv {it['url']}"
            old = (prev.get(key) or {}).get("sig", {})
            if old.get("seen") == it["updatedAt"] and "talk" in old:
                talk = old["talk"]  # nothing happened since the last read
            elif kind == "prs":
                d = pr_detail(repo, it["number"])
                talk = others(d.get("comments"), login) + others(d.get("reviews"), login) if d else None
            else:
                talk = issue_talk(repo, it["number"], login)
            # Only what others say counts; Dan's own approvals and comments don't.
            add(key, "involves you", repo, it["number"], it["title"], it["url"],
                {"talk": talk, "seen": it["updatedAt"]} if talk is not None else {"updated": it["updatedAt"]})

    for term, pr in topical:
        key = f"topic {pr['url']}"
        if key in snap:
            continue
        repo = pr["repository"]["nameWithOwner"]
        d = detail(repo, pr["number"])
        add(key, f"matches '{term}'", repo, pr["number"], pr["title"], pr["url"],
            {"head": d.get("headRefOid") or pr["updatedAt"]})

    def theirs(pr):
        who = (pr.get("author") or {}).get("login") or ""
        return who != login and not who.endswith("[bot]") and who != "app/dependabot" and \
            pr["repository"]["nameWithOwner"] in REPOS

    # A PR's files are read once, when it first shows up; after that its areas come from prev.
    for pr in recent:
        if not theirs(pr):
            continue
        repo, key = pr["repository"]["nameWithOwner"], f"area {pr['url']}"
        old = (prev.get(key) or {}).get("sig")
        if old is not None:
            areas = old.get("areas", [])
        else:
            files = pr_files(repo, pr["number"])
            if files is None:
                continue  # try again next poll
            areas = sorted({a for r_, prefix, a in paths if r_ == repo for f in files if f.startswith(prefix)})
        add(key, "in your areas (" + ", ".join(areas) + ")", repo, pr["number"], pr["title"], pr["url"],
            {"areas": areas})

    # Only PRs still open a month after they went quiet are worth a nudge from here; older ones are
    # someone's parked work.
    for pr in unreviewed:
        if theirs(pr) and ago(pr["createdAt"]) < datetime.timedelta(days=30):
            add(f"help {pr['url']}", f"unreviewed for {ago(pr['createdAt']).days}d", pr["repository"]["nameWithOwner"],
                pr["number"], pr["title"], pr["url"], {})
    for pr in languishing:
        key = f"help {pr['url']}"
        if theirs(pr) and key not in snap and ago(pr["updatedAt"]) < datetime.timedelta(days=60):
            add(key, f"languishing, quiet {ago(pr['updatedAt']).days}d", pr["repository"]["nameWithOwner"],
                pr["number"], pr["title"], pr["url"], {"stale": "languishing"})

    mine_g, review_g = gerrit("owner:self status:open"), gerrit("reviewer:self -owner:self status:open")
    for c in mine_g or []:
        theirs_ps, talk = gerrit_others(c)
        add(f"gerrit {c['url']}", "your Gerrit change", "gerrit", c["number"], c.get("subject", ""), c["url"],
            {"theirs_ps": theirs_ps, "others_votes": votes(c, skip=who(c.get("owner"))), "talk": talk})
    for c in review_g or []:
        add(f"gerrit-review {c['url']}", "Gerrit review", "gerrit", c["number"], c.get("subject", ""), c["url"],
            {"head": (c.get("currentPatchSet") or {}).get("revision")})

    pool.shutdown()
    # The kinds whose sources answered this poll, even with nothing in them, so an empty kind still
    # counts as watched and its first item is news.
    queried = {"rr", "mine", "inv", "topic", "help"} | ({"area"} if paths else set()) | \
        ({"gerrit"} if mine_g is not None else set()) | ({"gerrit-review"} if review_g is not None else set())
    return snap, queried


def kinds(snap):
    return {k.split(" ", 1)[0] for k in snap}


def news(old, new, seeded):
    """What changed that Dan could act on, as lines. seeded: the kinds of item (rr, mine, help, gerrit,
    ...) the old snapshot already watched; a new item of an unseeded kind is taken in quietly."""
    out = []
    for key, it in new.items():
        was = old.get(key)
        s, w = it["sig"], (was or {}).get("sig", {})
        why = []
        if was is None:
            if key.split(" ", 1)[0] not in seeded:
                continue  # a kind of news this state file has never recorded: take it in quietly
            if key.startswith("gerrit "):
                continue  # agents open these as Dan
            if key.startswith("area ") and not it["sig"].get("areas"):
                continue  # read, but outside Dan's areas
            why.append("new")
        else:
            if s.get("head") and s.get("head") != w.get("head"):
                why.append("new commits")
            if s.get("decision") != w.get("decision") and s.get("decision"):
                why.append(s["decision"].lower().replace("_", " "))
            if s.get("ci") != w.get("ci") and s.get("ci") in ("failing", "green"):
                why.append(f"CI {s['ci']}")
            # A signature field the old state didn't have is a new baseline, not news (an upgrade).
            if "talk" in w and (s.get("talk") or 0) > (w.get("talk") or 0):
                why.append(f"{s['talk'] - (w.get('talk') or 0)} new comment(s) or review(s) from others")
            if "pushed" in w and (s.get("pushed") or 0) > (w.get("pushed") or 0):
                why.append("new commits from someone else")
            if s.get("theirs_ps") and "theirs_ps" in w and s["theirs_ps"] != w.get("theirs_ps"):
                why.append("new patch set from someone else")
            # New votes from others; votes cleared by Dan's own new patch set aren't news.
            if "others_votes" in w and set(s.get("others_votes") or []) - set(w.get("others_votes") or []):
                why.append("votes: " + ", ".join(s["others_votes"]))
            if s.get("updated") and s.get("updated") != w.get("updated"):
                why.append("new activity")
            if s.get("votes") is not None and s.get("votes") != w.get("votes"):
                why.append("votes: " + (", ".join(s["votes"]) or "none"))
            if s.get("stale") and s.get("stale") != w.get("stale"):
                why.append(s["stale"])
            if w.get("draft") and s.get("draft") is False:
                why.append("out of draft")
        if why:
            out.append(f"{it['kind']}: [{it['repo']}#{it['number']}]({it['url']}) {it['title']} ({', '.join(why)})")
    return out


def quiet(now, hours, weekends):
    a, b = hours
    in_hours = (now.hour >= a or now.hour < b) if a > b else (a <= now.hour < b)
    return in_hours or (not weekends and now.weekday() >= 5)


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--interval", type=int, default=600, help="seconds between polls (default 600)")
    p.add_argument("--terms", default=os.path.expanduser("~/watch-terms"),
                   help="file of search terms, one per line (default ~/watch-terms)")
    p.add_argument("--paths", default=os.path.expanduser("~/.config/vm/watch-paths"),
                   help="file of repo:path prefixes for Dan's areas (default ~/.config/vm/watch-paths)")
    p.add_argument("--quiet-hours", default="22-7", help="local hours to hold news, START-END, or 'none'")
    p.add_argument("--tz", default="America/Chicago", help="Dan's time zone (default America/Chicago)")
    p.add_argument("--state", default=STATE, help=f"state file (default {STATE})")
    p.add_argument("--weekends", action="store_true", help="deliver news on weekends too")
    p.add_argument("--now", action="store_true", help="on a first run, report what's there instead of recording it")
    p.add_argument("--once", action="store_true", help="poll once and exit, with or without news")
    a = p.parse_args()
    hours = None if a.quiet_hours == "none" else tuple(int(x) for x in a.quiet_hours.split("-"))

    login = me()
    # The state file keeps what's been seen and the news held through quiet hours, so a
    # restart neither repeats nor loses anything.
    try:
        saved = json.load(open(a.state))
        state, held = saved["snap"], saved.get("held", [])
        seen = set(saved.get("kinds", []))
    except (OSError, ValueError, KeyError, TypeError):
        state, held, seen = None, [], set()
    while True:
        terms = []
        if os.path.exists(a.terms):
            terms = [t.strip() for t in open(a.terms) if t.strip() and not t.startswith("#")]
        try:
            snap, queried = snapshot(login, terms, state, load_paths(a.paths))
        except Exception as e:  # a GitHub hiccup: try again next round
            print(f"pr-watch: {e}", file=sys.stderr)
            if a.once:
                return 1
            time.sleep(a.interval)
            continue
        if state is None and not a.now:
            lines = []
        else:
            # --now on a first run reports everything there is.
            lines = news(state or {}, snap, kinds(snap) if state is None else seen | kinds(state))
        state = snap
        seen |= kinds(snap) | queried
        held += [l for l in lines if l not in held]
        now = datetime.datetime.now(ZoneInfo(a.tz))
        deliver = held and not (hours and quiet(now, hours, a.weekends))
        if deliver:
            print("\n".join(held))
        os.makedirs(os.path.dirname(a.state) or ".", exist_ok=True)
        with open(a.state + ".tmp", "w") as f:
            json.dump({"snap": snap, "held": [] if deliver else held, "kinds": sorted(seen)}, f)
        os.replace(a.state + ".tmp", a.state)
        if deliver:
            return 0
        if a.once:
            return 0
        time.sleep(a.interval)


if __name__ == "__main__":
    sys.exit(main())
