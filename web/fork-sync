#!/usr/bin/env bash
# fork-sync: bring a fork's master up to date with upstream master.
# Plain git, no model tokens; fork-sync.timer runs it hourly. It never forces.
# By default it fast-forwards the BuildBuddy private fork and, if that fork's master has
# commits upstream doesn't, writes so to the status file and leaves the fork alone.
# With FORK_SYNC_MODE=merge (fork-sync@NAME, settings in ~/.config/vm/fork-sync/NAME.env)
# a fork that carries its own work gets upstream merged in, when the merge is clean;
# a conflict is written to the status file and the fork is left alone.
# The status file is what a dispatcher or Dan reads.
set -uo pipefail
dir=${FORK_SYNC_DIR:-$HOME/.cache/fork-sync.git}
status=${FORK_SYNC_STATUS:-$HOME/.config/vm/fork-sync.status}
up=${FORK_SYNC_UP:-https://github.com/buildbuddy-io/buildbuddy.git}
fork=${FORK_SYNC_FORK:-https://github.int.exe.xyz/dan-stowell/buildbuddy-private-fork.git}
mode=${FORK_SYNC_MODE:-ff}
say() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$1" | tee "$status"; }
mkdir -p "$(dirname "$status")"

if [ ! -d "$dir" ]; then
  # Blobless: commits and trees only; a push fetches the few blobs it needs from upstream.
  git init -q --bare "$dir"
  git -C "$dir" remote add up "$up"
  git -C "$dir" remote add fork "$fork"
  git -C "$dir" config remote.up.promisor true
  git -C "$dir" config remote.up.partialclonefilter blob:none
  git -C "$dir" config remote.fork.promisor true
  git -C "$dir" config remote.fork.partialclonefilter blob:none
fi
git -C "$dir" fetch -q --filter=blob:none up +refs/heads/master:refs/remotes/up/master || { say "failed: fetching upstream"; exit 1; }
git -C "$dir" fetch -q --filter=blob:none fork +refs/heads/master:refs/remotes/fork/master || { say "failed: fetching the fork"; exit 1; }
u=$(git -C "$dir" rev-parse refs/remotes/up/master) f=$(git -C "$dir" rev-parse refs/remotes/fork/master)
if [ "$u" = "$f" ]; then
  say "ok: fork master is upstream master (${u:0:12})"
elif git -C "$dir" merge-base --is-ancestor "$f" "$u"; then
  n=$(git -C "$dir" rev-list --count "$f..$u")
  git -C "$dir" push -q fork "$u:refs/heads/master" || { say "failed: pushing ${u:0:12} to the fork"; exit 1; }
  say "ok: fast-forwarded fork master by $n commits to ${u:0:12}"
elif git -C "$dir" merge-base --is-ancestor "$u" "$f"; then
  say "ok: fork master already has upstream master (${u:0:12})"
elif [ "$mode" = merge ]; then
  n=$(git -C "$dir" rev-list --count "$f..$u")
  if ! tree=$(git -C "$dir" merge-tree --write-tree --name-only "$f" "$u"); then
    say "conflict: merging $n upstream commits (${u:0:12}) into fork master conflicts in: $(printf '%s' "$tree" | sed -n '2,6p' | tr '\n' ' '); not touched"
    exit 1
  fi
  m=$(git -C "$dir" -c user.name="fork-sync" -c user.email="fork-sync@spawn.exe.xyz" \
      commit-tree "$tree" -p "$f" -p "$u" -m "Merge upstream master (${u:0:12}, $n commits)") || { say "failed: writing the merge commit"; exit 1; }
  git -C "$dir" push -q fork "$m:refs/heads/master" || { say "failed: pushing the merge ${m:0:12} to the fork"; exit 1; }
  say "ok: merged $n upstream commits (${u:0:12}) into fork master as ${m:0:12}"
else
  n=$(git -C "$dir" rev-list --count "$u..$f")
  say "diverged: fork master has $n commits upstream doesn't (${f:0:12}); not touched"
  exit 1
fi
