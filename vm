#!/usr/bin/env bash
# vm NAME [PROMPT]: create an exe.dev VM (or reuse an existing one) and attach
# to a tmux session running a logged-in claude (with Remote Control) in $HOME.
# The VM gets the bb CLI (also as bazel and bazelisk), BUILDBUDDY_API_KEY,
# codex on Dan's ChatGPT sub, and shallow clones of the buildbuddy repos on a
# branch named NAME (tracking the remote branch if it exists), plus the
# guidance in vm-CLAUDE.md as claude's user-level CLAUDE.md and Shelley's
# AGENTS.md. PROMPT, if given, is sent to claude: as its first message in a new
# session, or pasted into the session that's already running.
#
# vm ls lists your VMs. vm backup [NAME...] runs vm-backup now, rather than
# waiting for its hourly run. vm rm NAME... backs up each VM's transcripts with
# vm-backup, then deletes it.
#
# The first run on a new VM logs claude in to claude.ai: the sign-in page opens
# in Chrome, and you paste the code it shows back into the terminal. Without a
# terminal (as under vm-web), vm instead prints the sign-in URL and exits 3;
# finish with vm login NAME CODE, then run vm NAME again.
#
# One-time setup: store a GitHub token and a BuildBuddy API key in the macOS
# keychain.
#   security add-generic-password -U -a "$USER" -s vm-github-token -w
#   security add-generic-password -U -a "$USER" -s buildbuddy-api-key -w
# Elsewhere, set VM_GITHUB_TOKEN and VM_BUILDBUDDY_API_KEY instead.
set -euo pipefail

chrome_profile=${VM_CHROME_PROFILE:-Profile 5}
claude_email=${VM_CLAUDE_EMAIL:-dstowell@gmail.com}
git_name=${VM_GIT_NAME:-Dan Stowell}
git_email=${VM_GIT_EMAIL:-dan@buildbuddy.io}

here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)

# Every exe.xyz VM presents the same host key (exe.dev's SSH proxy), so pin it
# once for all names instead of prompting for each new VM.
ssh_opts=(-o UserKnownHostsFile="$here/exe_known_hosts" -o StrictHostKeyChecking=yes)

# Matches the sign-in URL in claude auth login's output.
login_url_re='(https://claude\.com/cai/oauth/authorize[^[:space:][:cntrl:]]+)'

case ${1:-} in
  ls)
    shift
    exec ssh exe.dev ls "$@"
    ;;
  backup)
    shift
    exec "$here/vm-backup" "$@"
    ;;
  rm)
    shift
    if (( $# == 0 )); then
      echo "usage: vm rm NAME..." >&2
      exit 2
    fi
    # Back up each VM's transcripts one last time, and keep any VM whose
    # backup fails.
    status=0
    for name in "$@"; do
      if "$here/vm-backup" "$name"; then
        ssh exe.dev rm "$name" || status=1
      else
        echo "vm: backup of $name failed, so not deleting it" >&2
        status=1
      fi
    done
    exit $status
    ;;
  login)
    # Finishes a login started by a run without a terminal: types CODE into
    # the waiting claude auth login, then waits for it to take.
    if (( $# != 3 )); then
      echo "usage: vm login NAME CODE" >&2
      exit 2
    fi
    host="$2.exe.xyz"
    ssh "${ssh_opts[@]}" "$host" "tmux send-keys -t vm-login -l $(printf %q "$3") && tmux send-keys -t vm-login Enter"
    for _ in $(seq 30); do
      if ssh "${ssh_opts[@]}" "$host" 'claude auth status >/dev/null 2>&1'; then
        ssh "${ssh_opts[@]}" "$host" 'tmux kill-session -t vm-login 2>/dev/null || true'
        echo "Logged in."
        exit 0
      fi
      sleep 2
    done
    echo "vm: login on $host didn't complete; the code may be wrong or expired. Its screen:" >&2
    ssh "${ssh_opts[@]}" "$host" 'tmux capture-pane -p -J -t vm-login' >&2 || true
    ssh "${ssh_opts[@]}" "$host" 'tmux kill-session -t vm-login 2>/dev/null || true'
    exit 1
    ;;
esac

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "usage: vm NAME [PROMPT] | vm ls | vm backup [NAME...] | vm rm NAME... | vm login NAME CODE" >&2
  exit 2
fi
name=$1
prompt=${2:-}
host="$name.exe.xyz"
# exe.dev's naming rule, checked up front so a bad name fails before any work.
if (( ${#name} < 5 || ${#name} > 52 )) || [[ ! $name =~ ^[a-z][a-z0-9]*(-[a-z0-9]+)*$ ]]; then
  echo "vm: invalid name \"$name\": use 5-52 lowercase letters, digits and single hyphens, starting with a letter" >&2
  exit 2
fi
gh_token=${VM_GITHUB_TOKEN:-}
if [[ -z $gh_token ]] && ! gh_token=$(security find-generic-password -a "$USER" -s vm-github-token -w 2>/dev/null); then
  echo "vm: no GitHub token in keychain or VM_GITHUB_TOKEN; see the setup notes at the top of $here/vm" >&2
  exit 1
fi
bb_api_key=${VM_BUILDBUDDY_API_KEY:-}
if [[ -z $bb_api_key ]] && ! bb_api_key=$(security find-generic-password -a "$USER" -s buildbuddy-api-key -w 2>/dev/null); then
  echo "vm: no BuildBuddy API key in keychain or VM_BUILDBUDDY_API_KEY; see the setup notes at the top of $here/vm" >&2
  exit 1
fi

if ssh exe.dev ls --json | jq -e --arg n "$name" '.vms[] | select(.vm_name == $n)' >/dev/null; then
  echo "Reusing existing VM $name."
else
  echo "Creating $name..."
  ssh exe.dev new --name "$name" --cpu 2 --memory 4GB --disk 25GB --no-email
fi

echo "Waiting for SSH..."
ready=
for _ in $(seq 60); do
  if ssh "${ssh_opts[@]}" -o ConnectTimeout=5 -o BatchMode=yes "$host" true 2>/dev/null; then
    ready=1
    break
  fi
  sleep 2
done
if [[ -z $ready ]]; then
  echo "vm: $host did not accept SSH within 2 minutes" >&2
  exit 1
fi

# Secrets travel on stdin so they never show up in a process list.
remote_setup=$(cat <<'EOF'
set -euo pipefail
branch=$1 git_name=$2 git_email=$3

IFS= read -r gh_token
IFS= read -r bb_api_key
gh auth login --hostname github.com --git-protocol https --with-token <<<"$gh_token"
gh auth setup-git --hostname github.com
git config --global user.name "$git_name"
git config --global user.email "$git_email"

# tmux starts login shells, which read ~/.profile.
mkdir -p ~/.config/vm
(umask 077 && printf 'export BUILDBUDDY_API_KEY=%q\n' "$bb_api_key" > ~/.config/vm/env)
grep -q 'config/vm/env' ~/.profile || echo '[ -f ~/.config/vm/env ] && . ~/.config/vm/env' >> ~/.profile

if ! command -v bb >/dev/null; then
  echo "Installing bb..."
  arch=$(uname -m)
  [ "$arch" = aarch64 ] && arch=arm64
  tmp=$(mktemp -d)
  gh release download --repo buildbuddy-io/bazel --pattern "bazel-*-linux-$arch" --dir "$tmp"
  sudo install -m 0755 "$tmp"/bazel-*-linux-"$arch" /usr/local/bin/bb
  rm -rf "$tmp"
fi
sudo ln -sf bb /usr/local/bin/bazel
sudo ln -sf bb /usr/local/bin/bazelisk

# Point codex at the exe.dev LLM integration, which carries Dan's ChatGPT sub.
mkdir -p ~/.codex
cat > ~/.codex/config.toml <<'TOML'
model = "gpt-6-astra"
model_provider = "exe-llm"

[model_providers.exe-llm]
name = "exe-llm"
base_url = "https://llm.int.exe.xyz/v1"
TOML

for repo in buildbuddy buildbuddy-internal buildbuddy-helm buildbuddy-toolchain; do
  if [ ! -d ~/"$repo"/.git ]; then
    echo "Cloning $repo..."
    gh repo clone "buildbuddy-io/$repo" ~/"$repo" -- --quiet --depth 1 --branch master
    if git -C ~/"$repo" ls-remote --exit-code --heads origin "$branch" >/dev/null; then
      git -C ~/"$repo" remote set-branches --add origin "$branch"
      git -C ~/"$repo" fetch --quiet --depth 1 origin "$branch"
      git -C ~/"$repo" checkout --quiet -b "$branch" --track "origin/$branch"
    else
      git -C ~/"$repo" checkout --quiet -b "$branch"
    fi
  fi
done
EOF
)
ssh "${ssh_opts[@]}" "$host" "bash -c $(printf %q "$remote_setup") _ $(printf '%q ' "$name" "$git_name" "$git_email")" \
  <<<"$gh_token"$'\n'"$bb_api_key"

# Guidance for every claude and Shelley on the VM. Rewritten on each run, so
# edit vm-CLAUDE.md here rather than on the VM.
ssh "${ssh_opts[@]}" "$host" 'mkdir -p ~/.claude ~/.config/shelley &&
  tee ~/.claude/CLAUDE.md >~/.config/shelley/AGENTS.md' <"$here/vm-CLAUDE.md"

# Codex gets the same guidance, minus the bullet about asking codex for
# reviews, after the exe.dev note its AGENTS.md ships with. That note is set
# aside on the first run so later runs don't stack copies of the guidance.
awk '/^- After every push, ask codex/ { skip = 1; next }
     /^[-#]/ { skip = 0 }
     !skip' "$here/vm-CLAUDE.md" |
  ssh "${ssh_opts[@]}" "$host" 'mkdir -p ~/.codex && cd ~/.codex &&
    { [ -e AGENTS.exe-dev.md ] || cp AGENTS.md AGENTS.exe-dev.md 2>/dev/null || : >AGENTS.exe-dev.md; } &&
    { cat AGENTS.exe-dev.md; echo; cat; } >AGENTS.md'

# Echo login output through, and open the sign-in URL in the right Chrome
# profile as soon as it appears. Keeps reading to EOF so tee never gets SIGPIPE.
open_login_url() {
  local line opened=
  while IFS= read -r line; do
    if [[ -z $opened && $line =~ $login_url_re ]]; then
      open -na "Google Chrome" --args --profile-directory="$chrome_profile" "${BASH_REMATCH[1]}"
      opened=1
    fi
  done
}

# Remote Control needs a full claude.ai login; setup-token tokens can't do it.
if ! ssh "${ssh_opts[@]}" "$host" 'claude auth status >/dev/null 2>&1'; then
  if [[ ! -t 0 || ! -t 1 ]]; then
    # No terminal to paste a code into, so leave the login waiting in tmux on
    # the VM (a wide window, so the URL isn't wrapped) for vm login to finish.
    ssh "${ssh_opts[@]}" "$host" "tmux kill-session -t vm-login 2>/dev/null
      tmux new-session -d -s vm-login -x 2000 -y 50 claude auth login --claudeai --email $(printf %q "$claude_email")"
    url=
    for _ in $(seq 30); do
      if [[ $(ssh "${ssh_opts[@]}" "$host" 'tmux capture-pane -p -J -t vm-login') =~ $login_url_re ]]; then
        url=${BASH_REMATCH[1]}
        break
      fi
      sleep 1
    done
    if [[ -z $url ]]; then
      echo "vm: claude auth login on $host never showed a sign-in URL" >&2
      exit 1
    fi
    echo "vm: claude on $host needs a one-time login."
    echo "vm: sign in at $url"
    echo "vm: then run: vm login $name CODE, and vm $name again"
    exit 3
  fi
  echo "Logging claude in to claude.ai (opening Chrome: $chrome_profile)..."
  ssh "${ssh_opts[@]}" -t "$host" claude auth login --claudeai --email "$claude_email" | tee >(open_login_url)
  if ! ssh "${ssh_opts[@]}" "$host" 'claude auth status >/dev/null 2>&1'; then
    echo "vm: claude login on $host didn't complete; run vm $name again to retry" >&2
    exit 1
  fi
fi

remote_start=$(cat <<'EOF'
set -euo pipefail
name=$1
prompt=$2

if ! tmux has-session -t claude 2>/dev/null; then
  # Skip claude's first-run onboarding and the folder trust prompt for $HOME.
  # Only touched while claude isn't running, since claude rewrites this file.
  [ -f ~/.claude.json ] || echo '{}' > ~/.claude.json
  jq --arg home "$HOME" '.hasCompletedOnboarding = true | .projects[$home].hasTrustDialogAccepted = true' \
    ~/.claude.json > ~/.claude.json.tmp && mv ~/.claude.json.tmp ~/.claude.json
  # The VM is the sandbox, so skip permission prompts, and skip the one-time
  # warning dialog about doing that. Also start in the fullscreen renderer
  # rather than being offered it at startup, and on Opus.
  mkdir -p ~/.claude
  [ -f ~/.claude/settings.json ] || echo '{}' > ~/.claude/settings.json
  jq '.skipDangerousModePermissionPrompt = true | .tui = "fullscreen" | .model = "opus"' \
    ~/.claude/settings.json > ~/.claude/settings.json.tmp && mv ~/.claude/settings.json.tmp ~/.claude/settings.json

  tmux new-session -d -s claude -c "$HOME"
  cmd="claude --dangerously-skip-permissions --remote-control $name"
  [ -z "$prompt" ] || cmd+=" $(printf %q "$prompt")"
  tmux send-keys -t claude "$cmd" Enter
elif [ -n "$prompt" ]; then
  # Bracketed paste, so a multi-line prompt isn't submitted at its first newline.
  printf '%s' "$prompt" | tmux load-buffer -b vm-prompt -
  tmux paste-buffer -p -d -b vm-prompt -t claude
  sleep 0.5
  tmux send-keys -t claude Enter
fi
EOF
)
ssh "${ssh_opts[@]}" "$host" "bash -c $(printf %q "$remote_start") _ $(printf %q "$name") $(printf %q "$prompt")"

if [[ -t 1 ]]; then
  exec ssh "${ssh_opts[@]}" -t "$host" tmux attach -t claude
fi
echo "Ready: ssh -t $host tmux attach -t claude"
